{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "srs/Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/local/srs/objs/srs -c /usr/local/srs/conf/srs.conf",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
